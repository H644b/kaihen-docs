{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaihen-docs",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/mcp",
      "/mcp/*",
      "/api/*",
      "/health",
      "/llms.txt",
      "/llms-full.txt"
    ],
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "kaihen.timsfun.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
